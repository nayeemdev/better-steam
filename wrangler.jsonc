{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "better-steam",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./public" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "better-steam",
      "database_id": "79651a0a-5fcf-4a17-a527-e739c653b102",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["*/10 * * * *"] },
  "ratelimits": [
    { "name": "LOOKUP_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
