{
  "name": "better-steam",
  "description": "A calmer, clearer way to find Steam games worth buying, with real regional prices and honest deal verdicts.",
  "homepage": "https://steam.nayeemdev.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/nayeemdev/better-steam.git"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply better-steam --local",
    "db:migrate": "wrangler d1 migrations apply better-steam --remote",
    "types": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit",
    "test": "node --test"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "wrangler": "4.157.0"
  }
}
